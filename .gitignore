/data/

# --- Secrets ---
.env
*.pem
*.key

# --- Python caches / build ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# --- MLflow local stores / artifacts (Phase 2+) ---
mlruns/
mlartifacts/
mlflow.db

# --- Trained model bundles (regenerated by `make train`) ---
# Anchored: must not match src/fraudops/models/
/models/

# --- Notebooks / experiments ---
.ipynb_checkpoints/

# --- Local scratch (may contain real data rows) ---
tmp_*


# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# generated reports (evidently HTML, figures) — anchored: must not match
# src/fraudops/reports/ (the code that generates them)
/reports/

# --- Terraform (LocalStack runs only; state is local, never committed).
# The lock file IS committed (provider pinning); .terraform/ and state are not.
.terraform/
*.tfstate
*.tfstate.*
crash.log

