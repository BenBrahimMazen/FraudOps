# FraudOps local environment — copy to .env and adjust if needed.
# NEVER commit .env. All values below are local-only defaults for Docker Compose
# (zero-cost stack: no cloud accounts, no real secrets).

# --- PostgreSQL (predictions, labels, monitoring; Airflow metadata in Phase 2) ---
POSTGRES_USER=fraudops
POSTGRES_PASSWORD=fraudops-local
POSTGRES_DB=fraudops
# 5433 on the host by default: a native PostgreSQL often already owns 5432
POSTGRES_PORT=5433

# --- MinIO (S3-compatible artifact store for MLflow) ---
MINIO_ROOT_USER=fraudops
MINIO_ROOT_PASSWORD=fraudops-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=fraudops
AWS_SECRET_ACCESS_KEY=fraudops-local

# --- FastAPI serving ---
API_PORT=8000
FRAUDOPS_ADMIN_TOKEN=change-me-local-dev-token

# --- Kafka (Phase 3, `full` profile) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- LocalStack + terraform (Phase 6, `tools` profile; zero-cost AWS emulation) ---
LOCALSTACK_PORT=4566
